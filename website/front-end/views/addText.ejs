<!DOCTYPE html>
<html>
    <head>
        <title>Add-Doc</title>
        <link rel="stylesheet" href="css/site.css">
    </head>
    <body>
        <%- include('partials/header.ejs') %>
        <section>
            <h1>Add-Doc</h1>
            <h2><%= error %></h2>
            <form action="/addText" method="post" >
                <div>
                    <label for="category">Name:</label>
                    <input type="text" name="name" value="<%= name %>" placeholder="Name" required/>
                </div>
                <div>
                    <label for="setup">Path:</label>
                    <input type="text" name="path" value="<%= path %>" placeholder="Path" />
                </div>
                <div>
                    <label for="setup">Contents:</label>
                    <textarea rows="15" cols="80" type="text" name="content" placeholder="Content" required><%= content %></textarea>
                </div>
                
                <input type="submit" value="Submit"/>
            </form>
        </section>
        <%- include('partials/footer.ejs') %>
    </body>
</html>