<!DOCTYPE html>
<html>
    <head>
        <title>Add-Pic</title>
        <link rel="stylesheet" href="http://localhost:5000/css/site.css">
    </head>
    <body>
        <%- include('partials/header.ejs') %>
        <section>
            <h1>Edit-Pic</h1>
            <h2><%= error %></h2>
            <form action="/edit-pic/<%= id %>" method="post">
                <div>
                    <label for="category">Name:</label>
                    <input type="text" name="name" value="<%= name %>" placeholder="Name" required/>
                </div>
                <div>
                    <label for="setup">Description:</label>
                    <input type="text" name="des" value="<%= des %>" placeholder="Description" required/>
                </div>
                
                <input type="submit" value="Submit"/>
            </form>
        </section>
        <%- include('partials/footer.ejs') %>
    </body>
</html>