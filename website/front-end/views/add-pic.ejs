<!DOCTYPE html>
<html>
    <head>
        <title>Add-Pic</title>
        <link rel="stylesheet" href="css/site.css">
    </head>
    <body>
        <%- include('partials/header.ejs') %>
        <section>
            <h1>Add-Pic</h1>
            <h2><%= error %></h2>
            <form action="<%= api %>add-pic" method="post" enctype="multipart/form-data">
                <div>
                    <input type="hidden" name="userId" value="<%= userid %>">
                </div>
                <div>
                    <label for="category">Name:</label>
                    <input type="text" name="name" value="<%= name %>" placeholder="Name" required/>
                </div>
                <div>
                    <label for="setup">Description:</label>
                    <input type="text" name="des" value="<%= des %>" placeholder="Description" required/>
                </div>
                <div>
                    <label for="setup">Image:</label>
                    <input type="file" id="image" name="image" accept="image/*" required>
                </div>
                
                <input type="submit" value="Submit"/>
            </form>
        </section>
        <%- include('partials/footer.ejs') %>
    </body>
</html>